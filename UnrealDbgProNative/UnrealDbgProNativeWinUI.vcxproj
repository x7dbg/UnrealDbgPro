  <Target Name="CopyWinUIBootstrap" AfterTargets="Build">
    <Copy SourceFiles="$(WindowsAppSDKPackageDir)runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)bin" />
    <MakeDir Directories="$(OutDir)Config;$(OutDir)Certificates" />
    <!--
      WinUI 项目直接构建时，项目引用会把最新文件写入各自的 x64\$(Configuration)
      目录；不能再用旧版 x64\Release\bin 的通配符覆盖它们（尤其是
      UnrealDbgDll.dll 的导出表和驱动安全修复）。每个项目产物都显式指定来源，
      只有外部运行时组件才从历史 bin 目录回退复制。
    -->
    <ItemGroup>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.dll')">
        <DestinationFile>$(OutDir)bin\UnrealDbgProDll.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\D-encryptiondll\x64\$(Configuration)\D-encryption.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\x64\$(Configuration)\D-encryption.dll')">
        <DestinationFile>$(OutDir)bin\D-encryption.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\x64\$(Configuration)\D-encryption.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\x64\$(Configuration)\D-encryption.dll') and Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\x64\$(Configuration)\D-encryption.dll')">
        <DestinationFile>$(OutDir)bin\D-encryption.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\Hook\x64\$(Configuration)\Hook64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\Hook\x64\$(Configuration)\Hook64.dll')">
        <DestinationFile>$(OutDir)bin\Hook64.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.sys')">
        <DestinationFile>$(OutDir)bin\DbgkSysWin10.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.sys')">
        <DestinationFile>$(OutDir)bin\DbgkSysWin11.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.sys')">
        <DestinationFile>$(OutDir)bin\VT_Driver.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\bin\AIHelper.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\bin\AIHelper.dll')">
        <DestinationFile>$(OutDir)bin\AIHelper.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\Release\bin\AIHelper.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\bin\AIHelper.dll') and Exists('$(MSBuildThisFileDirectory)..\x64\Release\bin\AIHelper.dll')">
        <DestinationFile>$(OutDir)bin\AIHelper.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\bin\VMProtectSDK64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\bin\VMProtectSDK64.dll')">
        <DestinationFile>$(OutDir)bin\VMProtectSDK64.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\Release\bin\VMProtectSDK64.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\bin\VMProtectSDK64.dll') and Exists('$(MSBuildThisFileDirectory)..\x64\Release\bin\VMProtectSDK64.dll')">
        <DestinationFile>$(OutDir)bin\VMProtectSDK64.dll</DestinationFile>
      </RuntimeDependency>
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDependency)" DestinationFiles="@(RuntimeDependency->'%(DestinationFile)')" SkipUnchangedFiles="true" Condition="'@(RuntimeDependency)'!=''" />
    <ItemGroup>
      <ExistingConfig Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\Config\*.*" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\Config')" />
      <ExistingCertificates Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\Certificates\*.*" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\Certificates')" />
    </ItemGroup>
    <Copy SourceFiles="@(ExistingConfig)" DestinationFolder="$(OutDir)Config" SkipUnchangedFiles="true" Condition="'@(ExistingConfig)'!=''" />
    <Copy SourceFiles="@(ExistingCertificates)" DestinationFolder="$(OutDir)Certificates" SkipUnchangedFiles="true" Condition="'@(ExistingCertificates)'!=''" />
    <ItemGroup>
      <!-- 驱动项目每次 WDK 构建都会在各自输出目录生成配套测试证书；
           优先复制本次构建的证书，避免发布包混入历史证书。 -->
      <FreshCertificate Include="$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.cer" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.cer')" />
      <FreshCertificate Include="$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.cer" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.cer')" />
      <FreshCertificate Include="$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.cer" Condition="Exists('$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.cer')" />
    </ItemGroup>
    <Copy SourceFiles="@(FreshCertificate)" DestinationFolder="$(OutDir)Certificates" SkipUnchangedFiles="true" Condition="'@(FreshCertificate)'!=''" />
    <MakeDir Directories="$(OutDir)Symbols" />
    <ItemGroup>
      <GeneratedMetadata Include="$(OutDir)*.winmd;$(OutDir)*.xml" />
      <GeneratedSymbols Include="$(OutDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedSymbols)" DestinationFolder="$(OutDir)Symbols" SkipUnchangedFiles="true" Condition="'@(GeneratedSymbols)'!=''" />
    <Delete Files="@(GeneratedMetadata);@(GeneratedSymbols)" />
  </Target>
  <Target Name="OrganizeWinUISymbols" AfterTargets="CopyWinUIBootstrap">
    <MakeDir Directories="$(OutDir)Symbols" />
    <ItemGroup>
      <LateSymbols Include="$(OutDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(LateSymbols)" DestinationFolder="$(OutDir)Symbols" SkipUnchangedFiles="true" Condition="'@(LateSymbols)'!=''" />
    <Delete Files="@(LateSymbols)" />
  </Target>
  <Target Name="OrganizeWinUIArtifacts" AfterTargets="Link">
    <MakeDir Directories="$(OutDir)Symbols" />
    <ItemGroup>
      <LinkArtifacts Include="$(OutDir)UnrealDbgProNativeWinUI.pdb;$(OutDir)UnrealDbgProNativeWinUI.lib;$(OutDir)UnrealDbgProNativeWinUI.exp" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(LinkArtifacts)" DestinationFiles="@(LinkArtifacts->'$(OutDir)Symbols\%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(LinkArtifacts)'!=''" />
    <Delete Files="@(LinkArtifacts)" />
    <!-- 旧版 WinUI 验证构建留下的 CopyVerify 文件不是运行时依赖，
         每次构建都清掉，避免再次污染精简发布根目录。 -->
    <Delete Files="$(OutDir)UnrealDbgProNativeWinUI_CopyVerify.exe;$(OutDir)UnrealDbgProNativeWinUI_CopyVerify.lib;$(OutDir)UnrealDbgProNativeWinUI_CopyVerify.exp" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.targets" />
  <Import Project="$(WindowsAppSDKPackageDir)build\native\Microsoft.WindowsAppSDK.targets" />
</Project>