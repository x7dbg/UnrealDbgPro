  <Target Name="CopyNativeRuntimeDependencies" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)bin;$(OutDir)Config;$(OutDir)Symbols;$(OutDir)Certificates" />
    <ItemGroup>
      <!-- 运行 DLL、注入 DLL 和驱动统一放入 bin；UnrealDbgDll 会以自身模块目录解析这些文件。 -->
      <RuntimeDependency Include="$(OutDir)UnrealDbgProDll.dll" Condition="Exists('$(OutDir)UnrealDbgProDll.dll')">
        <DestinationFile>$(OutDir)bin\UnrealDbgProDll.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.dll" Condition="!Exists('$(OutDir)UnrealDbgProDll.dll') and Exists('$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.dll')">
        <DestinationFile>$(OutDir)bin\UnrealDbgProDll.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\x64\$(Configuration)\D-encryption.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\x64\$(Configuration)\D-encryption.dll')">
        <DestinationFile>$(OutDir)bin\D-encryption.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\D-encryptiondll\x64\$(Configuration)\D-encryption.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\x64\$(Configuration)\D-encryption.dll') and Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\x64\$(Configuration)\D-encryption.dll')">
        <DestinationFile>$(OutDir)bin\D-encryption.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\Hook\x64\$(Configuration)\Hook64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\Hook\x64\$(Configuration)\Hook64.dll')">
        <DestinationFile>$(OutDir)bin\Hook64.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(OutDir)Hook64.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\Hook\x64\$(Configuration)\Hook64.dll') and Exists('$(OutDir)Hook64.dll')">
        <DestinationFile>$(OutDir)bin\Hook64.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.sys')">
        <DestinationFile>$(OutDir)bin\DbgkSysWin10.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(OutDir)DbgkSysWin10.sys" Condition="!Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.sys') and Exists('$(OutDir)DbgkSysWin10.sys')">
        <DestinationFile>$(OutDir)bin\DbgkSysWin10.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.sys')">
        <DestinationFile>$(OutDir)bin\DbgkSysWin11.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(OutDir)DbgkSysWin11.sys" Condition="!Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.sys') and Exists('$(OutDir)DbgkSysWin11.sys')">
        <DestinationFile>$(OutDir)bin\DbgkSysWin11.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.sys" Condition="Exists('$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.sys')">
        <DestinationFile>$(OutDir)bin\VT_Driver.sys</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(OutDir)VT_Driver.sys" Condition="!Exists('$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.sys') and Exists('$(OutDir)VT_Driver.sys')">
        <DestinationFile>$(OutDir)bin\VT_Driver.sys</DestinationFile>
      </RuntimeDependency>
      <!-- AIHelper/VMProtect 是外部运行时组件；若构建机已有副本，复制到 bin。 -->
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\AIHelper.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\AIHelper.dll')">
        <DestinationFile>$(OutDir)bin\AIHelper.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\Release\AIHelper.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\AIHelper.dll') and Exists('$(MSBuildThisFileDirectory)..\x64\Release\AIHelper.dll')">
        <DestinationFile>$(OutDir)bin\AIHelper.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(OutDir)AIHelper.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\AIHelper.dll') and !Exists('$(MSBuildThisFileDirectory)..\x64\Release\AIHelper.dll') and Exists('$(OutDir)AIHelper.dll')">
        <DestinationFile>$(OutDir)bin\AIHelper.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VMProtectSDK64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VMProtectSDK64.dll')">
        <DestinationFile>$(OutDir)bin\VMProtectSDK64.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(MSBuildThisFileDirectory)..\x64\Release\VMProtectSDK64.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VMProtectSDK64.dll') and Exists('$(MSBuildThisFileDirectory)..\x64\Release\VMProtectSDK64.dll')">
        <DestinationFile>$(OutDir)bin\VMProtectSDK64.dll</DestinationFile>
      </RuntimeDependency>
      <RuntimeDependency Include="$(OutDir)VMProtectSDK64.dll" Condition="!Exists('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\VMProtectSDK64.dll') and !Exists('$(MSBuildThisFileDirectory)..\x64\Release\VMProtectSDK64.dll') and Exists('$(OutDir)VMProtectSDK64.dll')">
        <DestinationFile>$(OutDir)bin\VMProtectSDK64.dll</DestinationFile>
      </RuntimeDependency>
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDependency)" DestinationFiles="@(RuntimeDependency->'%(DestinationFile)')" SkipUnchangedFiles="true" Condition="'@(RuntimeDependency)'!=''" />
    <ItemGroup>
      <ConfigDependency Include="$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\copyright.db" Condition="Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\copyright.db')" />
      <ConfigDependency Include="$(MSBuildThisFileDirectory)..\copyright.db" Condition="!Exists('$(MSBuildThisFileDirectory)..\D-encryptiondll\D-encryption\copyright.db') and Exists('$(MSBuildThisFileDirectory)..\copyright.db')" />
    </ItemGroup>
    <Copy SourceFiles="@(ConfigDependency)" DestinationFolder="$(OutDir)Config" SkipUnchangedFiles="true" Condition="'@(ConfigDependency)'!=''" />
    <ItemGroup>
      <!-- 驱动项目本次构建生成的证书必须与 SYS 成套复制到发布目录。 -->
      <FreshCertificate Include="$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.cer" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin10\x64\$(Configuration)\DbgkSysWin10.cer')" />
      <FreshCertificate Include="$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.cer" Condition="Exists('$(MSBuildThisFileDirectory)..\DbgkSysWin11\x64\$(Configuration)\DbgkSysWin11.cer')" />
      <FreshCertificate Include="$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.cer" Condition="Exists('$(MSBuildThisFileDirectory)..\VT_Driver\x64\$(Configuration)\VT_Driver.cer')" />
    </ItemGroup>
    <Copy SourceFiles="@(FreshCertificate)" DestinationFolder="$(OutDir)Certificates" SkipUnchangedFiles="true" Condition="'@(FreshCertificate)'!=''" />
    <!-- 编译器生成的 PDB/LIB/EXP 只用于诊断和链接，移出运行根目录。 -->
    <ItemGroup>
      <RootSymbolOutput Include="$(OutDir)*.pdb;$(OutDir)*.lib;$(OutDir)*.exp" />
      <SymbolOutput Include="@(RootSymbolOutput)" />
      <SymbolOutput Include="$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.pdb" Condition="Exists('$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.pdb')" />
      <SymbolOutput Include="$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.lib" Condition="Exists('$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.lib')" />
      <SymbolOutput Include="$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.exp" Condition="Exists('$(MSBuildThisFileDirectory)..\UnrealDbgProDll\x64\$(Configuration)\UnrealDbgProDll.exp')" />
    </ItemGroup>
    <Copy SourceFiles="@(SymbolOutput)" DestinationFolder="$(OutDir)Symbols" SkipUnchangedFiles="true" Condition="'@(SymbolOutput)'!=''" />
    <Delete Files="@(RootSymbolOutput)" />
    <!-- 某些项目在解决方案构建时仍将产物写入公共 OutDir；复制完成后
         清掉这些重复运行文件，防止下一次编译重新污染发布根目录。 -->
    <Delete Files="$(OutDir)AIHelper.dll;$(OutDir)D-encryption.dll;$(OutDir)Hook64.dll;$(OutDir)VMProtectSDK64.dll;$(OutDir)UnrealDbgProDll.dll;$(OutDir)DbgkSysWin10.sys;$(OutDir)DbgkSysWin11.sys;$(OutDir)VT_Driver.sys;$(OutDir)copyright.db;$(OutDir)DbgkSysWin10.cer;$(OutDir)DbgkSysWin11.cer;$(OutDir)VT_Driver.cer" />
    <!-- WDK 的默认打包步骤还可能创建同名子目录并放入一份重复 SYS；
         bin 已是唯一运行位置，清理这些空的历史输出目录。 -->
    <Delete Files="$(OutDir)DbgkSysWin10\DbgkSysWin10.sys;$(OutDir)DbgkSysWin11\DbgkSysWin11.sys;$(OutDir)VT_Driver\VT_Driver.sys" />
    <RemoveDir Directories="$(OutDir)DbgkSysWin10;$(OutDir)DbgkSysWin11;$(OutDir)VT_Driver" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>