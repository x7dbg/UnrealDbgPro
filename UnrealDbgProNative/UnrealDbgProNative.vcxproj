  <ItemGroup>
    <ProjectReference Include="..\UnrealDbgProDll\UnrealDbgProDll.vcxproj">
      <Project>{FC047E85-1CAF-4668-A4A2-E3F7501C8BEA}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- 这些项目提供 bin 中的注入组件和驱动。声明为构建依赖，
         使整理目标在所有运行产物生成后执行，即使启用 /m 并行构建也不会
         有项目在整理完成后再次把 DLL/SYS 写回发布根目录。 -->
    <ProjectReference Include="..\Hook\Hook.vcxproj">
      <Project>{413FDE8A-1144-4C1B-B6FD-354227A78848}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\DbgkSysWin10\DbgkSysWin10.vcxproj">
      <Project>{C26EF961-AABF-4107-BD02-C4D5CAF155D8}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\DbgkSysWin11\DbgkSysWin11.vcxproj">
      <Project>{6D281073-FCA3-45A1-935A-1604CEDBBE79}</Project>
